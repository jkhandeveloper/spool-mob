{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.spool.zasstech.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.spool.zasstech.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "net.spoolapp.spool"
      }
    }
  }
}
